# appq MCP connection. The autotest-executor/-validator/-autotest workflows and
# their backing tools are deployed to the real origin (PR #622, merged to
# appq/prod/iron) — point at that unless you're testing appq-side changes that
# haven't landed there yet, in which case use a local Lando instance instead:
#   APPQ_ORIGIN=https://appliqation.lndo.site
# Lando's TLS cert is self-signed — Node will reject it by default. Either
# run with NODE_TLS_REJECT_UNAUTHORIZED=0 for local-only testing, or trust
# Lando's CA in your system store first. Never disable cert verification
# against a real (non-Lando) origin.
APPQ_ORIGIN=https://appq.appliqation.io
# A "vibe API key" — appq_vibe_api's own key system (the MCP module), from
# /admin/config/appq/vibe-api-keys. Needs "use vibe api write" + "use vibe api
# intelligence" permissions and membership in whatever project you're testing
# against — an appq API key is scoped to the user it belongs to, not global.
APPQ_API_KEY=

# LLM provider — set exactly one; checked in this order, first configured
# wins: Anthropic, OpenAI, DeepSeek, GLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# Model selection. Deliberately split by provider (their model IDs aren't
# interchangeable) AND by role: the validator's judgment (compare captured
# evidence against a known expected_result) is closer to bounded
# classification than the executor's open-ended browser-driving planning --
# a reasonable place for a cheaper/faster model, and a genuinely different
# model is one more decorrelation lever against same-model self-grading
# risk. Role overrides win over the blanket one; leave everything unset to
# use each provider's own default (see providers/anthropic.ts,
# providers/openai.ts). For cheap end-to-end testing before trusting this
# against a real project, the blanket override alone is enough, e.g.:
#   ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL=
ANTHROPIC_EXECUTOR_MODEL=
ANTHROPIC_VALIDATOR_MODEL=
OPENAI_MODEL=
OPENAI_EXECUTOR_MODEL=
OPENAI_VALIDATOR_MODEL=
# DeepSeek/GLM have no built-in default (unlike Anthropic/OpenAI above) —
# DEEPSEEK_MODEL/GLM_MODEL (or their role-specific overrides) are REQUIRED
# when that provider is selected; model IDs on both move fast, so a stale
# hardcoded default would be worse than a clear startup error.
DEEPSEEK_MODEL=
DEEPSEEK_EXECUTOR_MODEL=
DEEPSEEK_VALIDATOR_MODEL=
GLM_MODEL=
GLM_EXECUTOR_MODEL=
GLM_VALIDATOR_MODEL=
ANTHROPIC_MAX_TOKENS=4096
OPENAI_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_MAX_TOKENS=4096
GLM_MAX_TOKENS=4096
# Base URLs default to the public endpoints — override only for a
# proxy/self-host.
DEEPSEEK_BASE_URL=https://api.deepseek.com
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Vision caveat, real and worth knowing before picking a model here: this
# agent's executor attaches screenshots (LlmMessage.images) when the
# validator's mandatory/on-demand image-viewing mode is exercised.
# DeepSeek's chat models are text-only as of public docs; GLM has
# vision-capable variants (GLM-4V-class) but not every GLM model does — pick
# a vision-capable model explicitly if you rely on screenshot evidence with
# either provider.

# Budget caps for the think->act->observe loop
BUDGET_MAX_CALLS=50
BUDGET_MAX_PAGES=12
BUDGET_MAX_MILLIS=900000
BUDGET_MAX_TURNS=80
# Broad backstop against runaway spend, not a tuned budget (the caps above
# normally end a run first) — total tokens across the whole run, cache included.
BUDGET_MAX_TOTAL_TOKENS=2000000

# Validator image-viewing default (see judge --mandatory-image-check to
# override per run). false = on-demand: the model requests view_screenshot
# only when accessibility-snapshot/console/network text evidence isn't
# enough (most steps). true = every step's screenshot is fetched and
# attached unconditionally -- more tokens, stronger guarantee. This is a
# deployment/customer token-budget choice, not a testing-methodology one.
MANDATORY_IMAGE_CHECK=false

# Executor's in-memory console/network ring buffer per page, before older
# entries get dropped. Only matters for very long-running/chatty pages.
EVIDENCE_RING_BUFFER_CAP=500

# `run`'s poll for the deterministic path to settle (SQS-driven, no
# blocking/webhook API) -- how often to check, and how long to wait before
# reporting a TC as still pending.
POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=120000

# Audit logging — entirely opt-in, nothing is recorded anywhere unless one of
# these is set. Precedence: Mongo (if fully configured) > JSONL > none. This
# is a parallel system's own audit trail, deliberately not part of appq —
# see @appliqation/agent-core's audit/sink.ts. AUDIT_MONGO_DB/_COLLECTION
# are required together with AUDIT_MONGO_URI — no default collection name.
AUDIT_MONGO_URI=
AUDIT_MONGO_DB=
AUDIT_MONGO_COLLECTION=
AUDIT_JSONL_PATH=

# Authenticated sessions (judge --role <name>): nothing to configure here.
# This client only ever reads the Playwright storageState file
# @appliqation/automation-sdk's setupAuth({project_id, role}) resolves
# (~/.appq-auth/ by default, override with APPQ_AUTH_STATE_DIR) -- it never
# performs login or handles credentials itself. If that file doesn't exist
# yet for a project/role, run:
#   npx appq-auth-setup --project-id <id> --role <name>
# first (needs APPQ_PROJECT_<id>_<ROLE>_USERNAME/_PASSWORD and
# APPLIQATION_SUT_BASE_URL set -- see Project Settings -> Automation
# Authentication -> "download .env for CI" for the exact values). Omit
# --role entirely for ungated projects; nothing changes for them.
