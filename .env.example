# appq MCP connection. The autotest-executor/-validator/-autotest workflows and
# their backing tools are deployed to the real origin (PR #622, merged to
# appq/prod/iron) — point at that unless you're testing appq-side changes that
# haven't landed there yet, in which case use a local Lando instance instead:
#   APPQ_ORIGIN=https://appliqation.lndo.site
# Lando's TLS cert is self-signed — Node will reject it by default. Either
# run with NODE_TLS_REJECT_UNAUTHORIZED=0 for local-only testing, or trust
# Lando's CA in your system store first. Never disable cert verification
# against a real (non-Lando) origin.
APPQ_ORIGIN=https://appq.appliqation.io
# A "vibe API key" — appq_vibe_api's own key system (the MCP module), from
# /admin/config/appq/vibe-api-keys. Needs "use vibe api write" + "use vibe api
# intelligence" permissions and membership in whatever project you're testing
# against — an appq API key is scoped to the user it belongs to, not global.
APPQ_API_KEY=

# LLM provider — set exactly one; ANTHROPIC_API_KEY is preferred if both are set
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Budget caps for the think->act->observe loop
BUDGET_MAX_CALLS=50
BUDGET_MAX_PAGES=12
BUDGET_MAX_MILLIS=900000

# Validator image-viewing default (see judge --mandatory-image-check to
# override per run). false = on-demand: the model requests view_screenshot
# only when accessibility-snapshot/console/network text evidence isn't
# enough (most steps). true = every step's screenshot is fetched and
# attached unconditionally -- more tokens, stronger guarantee. This is a
# deployment/customer token-budget choice, not a testing-methodology one.
MANDATORY_IMAGE_CHECK=false
