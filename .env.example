# appq MCP connection
APPQ_ORIGIN=https://appq.appliqation.io
APPQ_API_KEY=

# LLM provider — set exactly one; ANTHROPIC_API_KEY is preferred if both are set
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local-stand-in mode (Phase 1-2): submit_execution_evidence and
# get_automation_readiness don't exist in appq yet, so this app talks to an
# in-process stub built to docs/specs/*.md instead of a live endpoint.
# Flip to false once Phase 3 lands the real appq-side tools.
USE_LOCAL_STUB=true

# Budget caps for the think->act->observe loop
BUDGET_MAX_CALLS=50
BUDGET_MAX_PAGES=12
BUDGET_MAX_MILLIS=900000
